{
  "name": "codepicker-tool",
  "version": "2.4.0",
  "description": "Pick code into Markdown. Apply Markdown to code. Built for LLMs and quick backups.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@10.0.0",
  "bin": {
    "codepicker": "bin/codepicker.cjs",
    "codep": "bin/codepicker.cjs"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "husky && npm run build",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "bin/*",
    "CODEPICK_FORMAT.md"
  ],
  "keywords": [
    "glob",
    "cli",
    "ai",
    "prompt-toolkit",
    "backup-tool",
    "prompt-engineering",
    "prompt-generator",
    "llm-tools",
    "typescript"
  ],
  "author": "Rodny Estrada<rrodnyestrada1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodnye/codepicker.git"
  },
  "bugs": {
    "url": "https://github.com/rodnye/codepicker/issues"
  },
  "homepage": "https://github.com/rodnye/codepicker#readme",
  "dependencies": {
    "clipboardy": "^5.3.1",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "picomatch": "2.3.2"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "2.3.2"
    }
  }
}
