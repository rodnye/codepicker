{
  "name": "codepicker-tool",
  "version": "2.4.8",
  "description": "Pick code into Markdown. Apply Markdown to code. Built for LLMs and quick backups.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@10.0.0",
  "bin": {
    "codepicker": "dist/index.js",
    "codep": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "bin/*",
    "CODEPICK_FORMAT.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "glob",
    "cli",
    "ai",
    "prompt-toolkit",
    "backup-tool",
    "prompt-engineering",
    "prompt-generator",
    "llm-tools",
    "cli",
    "typescript"
  ],
  "author": "Rodny Estrada<rrodnyestrada1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodnye/codepicker.git"
  },
  "bugs": {
    "url": "https://github.com/rodnye/codepicker/issues"
  },
  "homepage": "https://github.com/rodnye/codepicker#readme",
  "dependencies": {
    "clipboardy": "^5.3.1",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.6.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "picomatch": "2.3.2"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "2.3.2"
    }
  }
}
